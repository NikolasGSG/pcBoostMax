# --------------------------------------------------------------------
# GameBoostApex — git ignore
# --------------------------------------------------------------------

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
*.pyo
*.pyd

# ---- Virtual envs ----
.venv/
venv/
env/
ENV/

# ---- PyInstaller / build artefacts ----
build/
dist/
*.manifest
*.spec.bak

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Test / coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- App runtime data (never commit user data!) ----
# This protects against accidentally committing local state if you
# ever symlink %LOCALAPPDATA%\GameBoostApexOptimizer into the repo.
GameBoostApexOptimizer/
*.log
ads_manifest.json

# ---- OS junk ----
ehthumbs.db
desktop.ini

# ---- Marketing artefacts produced by tools/capture_store_shots.py ----
# Regenerate locally with `python tools/capture_store_shots.py`.
store_screenshots/

# ---- Secrets ----
.env
.env.*
secrets/
*.key
*.pem
*.pfx
